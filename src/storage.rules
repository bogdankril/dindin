
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Only authenticated users can write to the logos directory.
    // The user's UID must be part of the path to ensure they only write to their own content.
    match /logos/{userId}/{allPaths=**} {
      allow read;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
