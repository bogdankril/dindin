    }

    /**
     * @description Controls access to archived job data. Only the owner (the user whose ID is in the path) can read, create, update, or delete archived job documents.
     * @path artifacts/{appId}/users/{userId}/archivedJobs/{archivedJobId}
     * @allow (create) User 'A' creates an archived job document under artifacts/appid/users/A/archivedJobs/job1
     * @allow (get, update, delete) User 'A' reads/updates/deletes an archived job document under artifacts/appid/users/A/archivedJobs/job1
